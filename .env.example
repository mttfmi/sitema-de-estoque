# Modelo das variáveis de ambiente. NÃO coloque valores reais aqui.
# Local: copie para ".env" (ignorado pelo git) e preencha.
# Render: cadastre cada uma em Environment.

# Connection string do Supabase (Session pooler)
DATABASE_URL=postgresql://postgres.SEU_PROJETO:SUA_SENHA@aws-0-sa-east-1.pooler.supabase.com:5432/postgres

# Chave que assina as sessões. Gere com:
#   python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=

# "production" no Render (liga cookie Secure, HSTS e desliga o debug). Vazio no PC.
FLASK_ENV=

# Só é usada para criar o PRIMEIRO administrador em produção (banco sem usuários).
# Escolha um valor longo e aleatório; depois de criar o admin pode até remover.
SETUP_KEY=

# Alertas no Telegram (opcional)
TELEGRAM_BOT_TOKEN=
TELEGRAM_CHAT_ID=
